# Copy to automl/.env. Run notebooks from automl/; never commit .env.
# Replace YOUR_PROJECT with an existing RHOAI project namespace (not its display name).
RHOAI_PROJECT=YOUR_PROJECT
# Pipeline server API endpoint from this project's Pipelines page, including https://.
KFP_ENDPOINT=https://ds-pipeline-pipelines-definition-YOUR_PROJECT.apps.YOUR_CLUSTER
# Optional RHOAI dashboard base URL, used for clickable Run details / AutoML results.
# Example: https://rh-ai.apps.YOUR_CLUSTER (replace with the actual dashboard address).
# This is different from KFP_ENDPOINT, which remains the pipeline API endpoint.
RHOAI_DASHBOARD_URL=
# OpenShift bearer token authorized to run pipelines in this project (oc whoami -t).
RHOAI_TOKEN=
# Optional path to a PEM CA bundle trusted by the pipeline server and REST endpoint.
REQUESTS_CA_BUNDLE=

# Create an S3-compatible Connection in the same project; attach it to the workbench.
# The Connection's Kubernetes Secret name, NOT its display name.
S3_CONNECTION_NAME=fraud-storage
# These values must match that Connection. Attached Connection env vars also work;
# values already in the environment take precedence over this file.
AWS_S3_ENDPOINT=https://s3.YOUR_REGION.amazonaws.com
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=YOUR_DATA_BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CA bundle for S3. Keep TLS verification enabled.
AWS_CA_BUNDLE=
# Bucket must exist. A new upload gets a unique subdirectory below this prefix.
S3_DATA_PREFIX=fraud-detection/automl/data
# Optional: default is AWS_S3_BUCKET. This must be the pipeline server's artifact
# bucket (configured under Pipelines), accessible with the same Connection.
S3_ARTIFACTS_BUCKET=
# Managed pipeline artifact convention; change to match run artifact URIs if needed.
S3_ARTIFACTS_PREFIX=autogluon-tabular-training-pipeline/{run_id}

MANAGED_PIPELINE_NAME=autogluon-tabular-training-pipeline
# Optional explicit version; otherwise latest registered version is resolved and recorded.
PIPELINE_VERSION_ID=
EXPERIMENT_NAME=fraud-detection-automl
# GA managed pipeline preset, not an AutoGluon SDK preset: speed or balanced.
AUTOML_PRESET=speed
# Supported metrics: roc_auc, f1, accuracy.
AUTOML_EVAL_METRIC=roc_auc
AUTOML_TOP_N=1
# speed has a 45-minute selection budget; refit, evaluation and scheduling add time.
PIPELINE_TIMEOUT_SECONDS=10800
# Optional local CSV defaults for notebook 00; you can also edit DATA_FILES there.
# Relative paths always start from automl/; absolute paths and ~/ paths also work.
# Custom files must keep the seven fraud feature names and the binary fraud label.
TRAIN_CSV=../data/train.csv
TEST_CSV=../data/test.csv
# Optional: leave empty if you have no validation file; also set MERGE_VALIDATION=false.
VALIDATION_CSV=../data/validate.csv
# true: merge the chosen train + validation CSVs; test always stays separate.
MERGE_VALIDATION=true

# Serving: use the dashboard instructions in 03_predictor, or create resources there.
# Kubernetes client uses workbench ServiceAccount or local kubeconfig (oc login).
# Namespace containing the installed RHOAI runtime template; ask admin if different.
RUNTIME_TEMPLATE_NAMESPACE=redhat-ods-applications
# Exact OpenShift Template metadata.name; verify with:
# oc get templates -n redhat-ods-applications
# The installed template name can differ from the kserve-autogluon-server image name.
RUNTIME_TEMPLATE_NAME=autogluon-runtime-template
SERVING_RUNTIME_NAME=fraud-automl-runtime
MODEL_NAME=fraud-automl
SERVING_CPU=2
SERVING_MEMORY=8Gi
SERVING_TIMEOUT_SECONDS=1200
# After deployment, copy the base Inference endpoint from the dashboard (no /v1/... suffix).
# If empty, the notebook tries the OpenShift Route, then InferenceService status.url.
PREDICT_ENDPOINT=
# auto: use PREDICT_TOKEN if nonempty, otherwise current Kubernetes credentials
# (local oc login/kubeconfig or workbench ServiceAccount). Credentials are reread
# for every prediction, never copied into .env. The identity needs inference access.
# token: require an explicit PREDICT_TOKEN. none: omit Authorization for a public endpoint.
PREDICT_AUTH_MODE=auto
# Optional explicit override; leave empty for automatic credentials.
PREDICT_TOKEN=
